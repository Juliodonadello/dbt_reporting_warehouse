    </DataSet>
    <DataSet Name="Lease_Status_parameter">
      <Query>
        <DataSourceName>SIRE_PROD</DataSourceName>
        <CommandText>SELECT distinct "reporting"."stg_leases"."lease_raw_status" "LEASE_STATUS"

FROM "reporting"."stg_leases"
INNER  JOIN "reporting"."stg_lease_units" ON "reporting"."stg_leases"."lease_id"="reporting"."stg_lease_units"."lease_id"
INNER  JOIN "reporting"."stg_units" ON "reporting"."stg_units"."unit_id"="reporting"."stg_lease_units"."unit_id"
INNER  JOIN "reporting"."stg_properties" ON "reporting"."stg_units"."property_id"="reporting"."stg_properties"."property_id"

WHERE CAST("reporting"."stg_properties"."company_relation_id" AS INT) = CAST(@REAL_COMPANY_ID AS INT)
    AND "reporting"."stg_properties"."prop_name" IN (@Property_Name)
    
GROUP BY "reporting"."stg_leases"."lease_raw_status" </CommandText>
        <QueryParameters>
          <QueryParameter Name="@Property_Name">
            <Value>=Parameters!Property_Name.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@REAL_COMPANY_ID">
            <Value>=Parameters!REAL_COMPANY_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="LEASE_STATUS">
          <DataField>LEASE_STATUS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="EntityId_parameter">
      <Query>
        <DataSourceName>SIRE_PROD</DataSourceName>
        <CommandText>SELECT  "reporting"."stg_properties"."entity_id" AS "ENTITY_ID" 

FROM  "reporting"."stg_properties"

WHERE CAST("reporting"."stg_properties"."company_relation_id" AS INT)  = CAST(@REAL_COMPANY_ID AS INT)
 and "reporting"."stg_properties"."deleted_at" IS NULL

GROUP BY  "reporting"."stg_properties"."entity_id"

ORDER BY "reporting"."stg_properties"."entity_id" asc</CommandText>
        <QueryParameters>
          <QueryParameter Name="@REAL_COMPANY_ID">
            <Value>=Parameters!REAL_COMPANY_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="ENTITY_ID">
          <DataField>ENTITY_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ItemId">
      <Query>
        <DataSourceName>SIRE_PROD</DataSourceName>
        <CommandText>SELECT DISTINCT "reporting"."stg_lease_recurring_charges"."item_id" AS "ITEM_ID"

FROM "reporting"."stg_lease_recurring_charges"
INNER JOIN "reporting"."stg_units" ON "stg_lease_recurring_charges"."unit_id" =  "stg_units"."unit_id"
INNER  JOIN "reporting"."stg_properties" ON "reporting"."stg_units"."property_id"="reporting"."stg_properties"."property_id"

WHERE ( "stg_lease_recurring_charges"."deleted_at" IS NULL)
	AND ("stg_lease_recurring_charges"."terminate_date" &gt;= @AsOfDate OR "stg_lease_recurring_charges"."terminate_date" IS NULL)
	AND "reporting"."stg_properties"."prop_name" IN (@Property_Name)
	AND CAST("reporting"."stg_properties"."company_relation_id" AS INT) = CAST(@REAL_COMPANY_ID AS INT)</CommandText>
        <QueryParameters>
          <QueryParameter Name="@AsOfDate">
            <Value>=Parameters!AsOfDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Property_Name">
            <Value>=Parameters!Property_Name.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@REAL_COMPANY_ID">
            <Value>=Parameters!REAL_COMPANY_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="ITEM_ID">
          <DataField>ITEM_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="month_to_month_parameter">
      <Query>
        <DataSourceName>SIRE_PROD</DataSourceName>
        <CommandText>SELECT CASE WHEN CAST("reporting"."stg_leases"."month_to_month_flag" AS TEXT) ='true' THEN 'True' ELSE 'False' END "M_t_M"

FROM "reporting"."stg_leases"
INNER  JOIN "reporting"."stg_lease_units" ON "reporting"."stg_leases"."lease_id"="reporting"."stg_lease_units"."lease_id"
INNER  JOIN "reporting"."stg_units" ON "reporting"."stg_units"."unit_id"="reporting"."stg_lease_units"."unit_id"
INNER  JOIN "reporting"."stg_properties" ON "reporting"."stg_units"."property_id"="reporting"."stg_properties"."property_id"

WHERE  CAST("reporting"."stg_properties"."company_relation_id" AS INT) = CAST(@REAL_COMPANY_ID AS INT)
    AND "reporting"."stg_properties"."prop_name" IN (@Property_Name)
    
GROUP BY "reporting"."stg_leases"."month_to_month_flag" </CommandText>
        <QueryParameters>
          <QueryParameter Name="@REAL_COMPANY_ID">
            <Value>=Parameters!REAL_COMPANY_ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Property_Name">
            <Value>=Parameters!Property_Name.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="M_t_M">
          <DataField>M_t_M</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
