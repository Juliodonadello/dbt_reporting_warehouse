        <Field Name="finalAdjustmentAmount">
          <DataField>finalAdjustmentAmount</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="current_cpi_date">
          <DataField>current_cpi_date</DataField>
