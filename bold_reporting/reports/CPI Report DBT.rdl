          <DataField>next_cpi_date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="index_1">
          <DataField>index_1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="area_1">
          <DataField>area_1</DataField>
