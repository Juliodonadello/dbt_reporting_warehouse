        </Field>
        <Field Name="floor_percent">
          <DataField>floor_percent</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PROP_NAME">
          <DataField>PROP_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UNIT_NAME">
          <DataField>UNIT_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LEASE_NAME">
          <DataField>LEASE_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TENANT_NAME">
          <DataField>TENANT_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
